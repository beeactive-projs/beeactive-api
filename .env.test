NODE_ENV=test

# Test database — separate from the dev DB so test runs don't trash dev data.
# Point this at a local Postgres instance named beeact_test.
# Create it once with: psql -U postgres -c "CREATE DATABASE beeact_test;"
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=1q2w3e4R
DB_DATABASE=beeact_test
# Alternatively, set TEST_DATABASE_URL for a connection-string style config.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/beeact_test

# JWT (required by Joi schema; use non-production values in tests)
JWT_SECRET=test-jwt-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=test-refresh-secret-minimum-32-characters-long

# All other vars default/optional — not needed for unit tests (DB is mocked).
